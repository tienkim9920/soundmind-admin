<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>
        SoundMind Admin
    </title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>
        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at top left,
                    #dbeafe,
                    transparent 35%),
                radial-gradient(circle at bottom right,
                    #e9d5ff,
                    transparent 35%),
                #f8fafc;
            overflow: hidden;
        }

        .left-side {
            position: relative;
            overflow: hidden;
            padding: 70px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, .7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255,
                    255,
                    255,
                    .7);
            padding: 10px 16px;
            border-radius: 999px;
            font-size: 12px;
            letter-spacing: 2px;
            color: #475569;
        }

        .hero-title {
            font-size: 58px;
            line-height: 1.1;
            font-weight: 700;
            margin-top: 28px;
            margin-bottom: 24px;
        }

        .hero-gradient {
            background:
                linear-gradient(to right,
                    #0f172a,
                    #6366f1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-desc {
            color: #64748b;
            font-size: 16px;
            line-height: 1.9;
            max-width: 520px;
        }

        .feature-card {
            background: rgba(255,
                    255,
                    255,
                    .65);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,
                    255,
                    255,
                    .7);
            border-radius: 24px;
            padding: 18px;
            margin-bottom: 18px;
            box-shadow:
                0 10px 30px rgba(15,
                    23,
                    42,
                    .05);
        }

        .feature-icon {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eef2ff;
            color: #4f46e5;
            font-size: 20px;
        }

        .login-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 32px;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            border: none;
            border-radius: 32px;
            background: rgba(255,
                    255,
                    255,
                    .78);
            backdrop-filter: blur(20px);
            box-shadow:
                0 25px 60px rgba(15,
                    23,
                    42,
                    .12);
        }

        .login-title {
            font-size: 34px;
            font-weight: 700;
        }

        .input-group-text {
            background: white;
            border-right: none;
            border-radius: 16px 0 0 16px;
        }

        .form-control {
            border-left: none;
            border-radius: 0 16px 16px 0;
            padding: 14px;
        }

        .form-control:focus {
            box-shadow: none;
            border-color: #ced4da;
        }

        .btn-login {
            border: none;
            border-radius: 16px;
            padding: 14px;
            font-weight: 600;
            background:
                linear-gradient(to right,
                    #111827,
                    #4f46e5);
            transition: .25s;
        }

        .btn-login:hover {
            transform: translateY(-1px);
            opacity: .96;
        }

        .footer-note {
            color: #94a3b8;
            font-size: 13px;
        }

        @media(max-width:992px) {
            .left-side {
                display: none;
            }

            body {
                overflow: auto;
            }
        }
    </style>
</head>

<body>

    <div class="container-fluid min-vh-100">

        <div class="row min-vh-100">

            <!-- LEFT -->
            <div class="col-lg-6 left-side">

                <div>

                    <div class="brand-badge">
                        <i class="bi bi-soundwave"></i>
                        SOUNDMIND ADMIN
                    </div>

                    <h1 class="hero-title">
                        Quản trị nội dung
                        <br>
                        <span class="hero-gradient">
                            tinh gọn & hiện đại
                        </span>
                    </h1>

                    <p class="hero-desc">
                        Theo dõi audiobook, quản lý nội dung và vận hành nền tảng SoundMind với trải nghiệm quản trị
                        trực quan.
                    </p>
                </div>

                <div>

                    <div class="feature-card d-flex gap-3 align-items-center">
                        <div class="feature-icon">
                            <i class="bi bi-headphones"></i>
                        </div>

                        <div>
                            <div class="fw-semibold">
                                Quản lý Audiobook
                            </div>

                            <div class="text-secondary small">
                                Kiểm soát thư viện và nội dung dễ dàng
                            </div>
                        </div>
                    </div>

                    <div class="feature-card d-flex gap-3 align-items-center">
                        <div class="feature-icon">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>

                        <div>
                            <div class="fw-semibold">
                                Theo dõi tăng trưởng
                            </div>

                            <div class="text-secondary small">
                                Dữ liệu vận hành theo thời gian thực
                            </div>
                        </div>
                    </div>

                    <div class="footer-note mt-4">
                        © 2026 SoundMind Admin
                    </div>

                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-lg-6 login-wrapper">

                <div class="card login-card p-4 p-lg-5">

                    <div class="card-body">

                        <div class="text-center mb-4">

                            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                                style="
                                width:70px;
                                height:70px;
                                background:#eef2ff;
                                color:#4f46e5;
                                font-size:28px;
                            ">
                                <i class="bi bi-shield-lock"></i>
                            </div>

                            <div class="login-title">
                                Đăng nhập Admin
                            </div>

                            <div class="text-secondary mt-2">
                                Chào mừng quay trở lại
                            </div>

                        </div>

                        <form id="loginForm">

                            <div class="mb-3">
                                <label class="small text-muted mb-2">
                                    Username
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person"></i>
                                    </span>

                                    <input id="username" type="text" class="form-control" placeholder="Nhập username"
                                        required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="small text-muted mb-2">
                                    Password
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-lock"></i>
                                    </span>

                                    <input id="password" type="password" class="form-control" placeholder="••••••••"
                                        required />
                                </div>
                            </div>

                            <div id="error" class="alert alert-danger d-none py-2 small"></div>

                            <button id="loginBtn" type="submit" class="btn btn-login text-white w-100 mt-2">
                                Đăng nhập
                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script>
        window.API_URL = "<%= apiUrl %>";
        document.addEventListener("DOMContentLoaded", () => {
            const form = document.getElementById("loginForm");
            const btn = document.getElementById("loginBtn");
            const errorBox = document.getElementById("error");

            form.addEventListener("submit", async (e) => {
                e.preventDefault();

                errorBox.classList.add("d-none");
                btn.disabled = true;
                btn.innerText = "Đang đăng nhập...";

                const username = document.getElementById("username").value;
                const password = document.getElementById("password").value;

                try {
                    const res = await fetch(`${window.API_URL}/auth/signin`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ username, password }),
                    });

                    const data = await res.json();

                    if (data.code !== 200) {
                        throw new Error(data.message || "Đăng nhập thất bại");
                    }

                    // Save token & user
                    localStorage.setItem("token", data.data.token);
                    document.cookie = `token=${encodeURIComponent(data.data.token)}; path=/; max-age=86400; SameSite=Lax`;
                    localStorage.setItem("user", JSON.stringify(data.data));

                    // Global event & redirect
                    window.dispatchEvent(new Event("auth-changed"));
                    window.location.href = "/books";

                } catch (err) {
                    errorBox.innerText = err.message || "Đăng nhập thất bại";
                    errorBox.classList.remove("d-none");
                } finally {
                    btn.disabled = false;
                    btn.innerText = "Đăng nhập";
                }
            });
        });
    </script>
</body>

</html>