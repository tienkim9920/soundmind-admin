<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoundMind Admin Login</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:Inter, Arial, sans-serif;
            background:#f8fafc;
            color:#0f172a;
        }

        .container{
            min-height:100vh;
            display:grid;
            grid-template-columns:1fr 1fr;
        }

        .left{
            display:flex;
            flex-direction:column;
            justify-content:space-between;
            padding:48px;
            position:relative;
            overflow:hidden;
            background:#f8fafc;
        }

        .blur1,
        .blur2{
            position:absolute;
            border-radius:999px;
            background:#e5e7eb;
            filter:blur(60px);
            opacity:.6;
        }

        .blur1{
            width:260px;
            height:260px;
            top:-80px;
            left:-40px;
        }

        .blur2{
            width:300px;
            height:300px;
            bottom:-80px;
            right:-40px;
        }

        .content{
            position:relative;
            z-index:2;
            max-width:500px;
        }

        .badge{
            display:inline-flex;
            align-items:center;
            gap:8px;
            padding:8px 14px;
            border-radius:999px;
            background:white;
            border:1px solid #e5e7eb;
            font-size:11px;
            letter-spacing:2px;
            text-transform:uppercase;
            color:#6b7280;
            margin-bottom:24px;
        }

        h1{
            font-size:46px;
            line-height:1.15;
            margin-bottom:22px;
            font-weight:600;
        }

        .gradient{
            background:linear-gradient(to right,#000,#9ca3af);
            -webkit-background-clip:text;
            -webkit-text-fill-color:transparent;
        }

        .desc{
            color:#6b7280;
            font-size:15px;
            line-height:1.8;
            margin-bottom:40px;
        }

        .card{
            display:flex;
            gap:16px;
            padding:18px;
            background:white;
            border:1px solid #e5e7eb;
            border-radius:18px;
            margin-bottom:16px;
            transition:.25s;
        }

        .card:hover{
            transform:translateY(-2px);
        }

        .icon{
            width:40px;
            height:40px;
            border-radius:12px;
            background:#f8fafc;
            border:1px solid #e5e7eb;
            display:flex;
            justify-content:center;
            align-items:center;
            font-size:18px;
        }

        .card-title{
            font-size:14px;
            font-weight:600;
            margin-bottom:6px;
        }

        .card-desc{
            color:#6b7280;
            font-size:13px;
            line-height:1.5;
        }

        .footer{
            color:#9ca3af;
            font-size:12px;
            position:relative;
            z-index:2;
        }

        .right{
            display:flex;
            justify-content:center;
            align-items:center;
            padding:40px;
            background:white;
        }

        .login-box{
            width:100%;
            max-width:460px;
        }

        .login-title{
            margin-bottom:40px;
        }

        .login-title h2{
            font-size:32px;
            margin-bottom:10px;
        }

        .login-title p{
            color:#6b7280;
            font-size:14px;
        }

        .form-group{
            margin-bottom:20px;
        }

        label{
            display:block;
            font-size:12px;
            color:#6b7280;
            margin-bottom:8px;
        }

        .input-wrap{
            display:flex;
            align-items:center;
            gap:10px;
            padding:14px 16px;
            border:1px solid #e5e7eb;
            border-radius:14px;
            transition:.2s;
        }

        .input-wrap:focus-within{
            border-color:#0f172a;
        }

        input{
            border:none;
            outline:none;
            width:100%;
            font-size:14px;
            background:transparent;
        }

        button{
            width:100%;
            border:none;
            padding:14px;
            border-radius:14px;
            background:linear-gradient(
                to right,
                #0f172a,
                #1e293b,
                #334155
            );
            color:white;
            font-size:14px;
            font-weight:600;
            cursor:pointer;
            transition:.2s;
        }

        button:hover{
            opacity:.95;
        }

        @media(max-width:900px){
            .container{
                grid-template-columns:1fr;
            }

            .left{
                display:none;
            }
        }
    </style>
</head>
<body>

<div class="container">

    <!-- LEFT -->
    <div class="left">

        <div class="blur1"></div>
        <div class="blur2"></div>

        <div class="content">

            <div class="badge">
                ✦ SOUNDMIND ADMIN
            </div>

            <h1>
                Quản trị hệ thống
                <br>
                một cách
                <span class="gradient">
                    tinh gọn
                </span>
            </h1>

            <p class="desc">
                Theo dõi nội dung, quản lý người dùng và vận hành
                nền tảng SoundMind với trải nghiệm quản trị hiện đại.
            </p>

            <div class="card">
                <div class="icon">🎧</div>
                <div>
                    <div class="card-title">
                        Quản lý audiobook
                    </div>
                    <div class="card-desc">
                        Kiểm soát nội dung và thư viện dễ dàng
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="icon">✨</div>
                <div>
                    <div class="card-title">
                        Quản trị thông minh
                    </div>
                    <div class="card-desc">
                        Giao diện tối giản và trực quan
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="icon">📈</div>
                <div>
                    <div class="card-title">
                        Theo dõi tăng trưởng
                    </div>
                    <div class="card-desc">
                        Phân tích hoạt động hệ thống theo thời gian thực
                    </div>
                </div>
            </div>

        </div>

        <div class="footer">
            © 2026 SoundMind Admin
        </div>
    </div>

    <!-- RIGHT -->
    <div class="right">

        <div class="login-box">

            <div class="login-title">
                <h2>Đăng nhập Admin</h2>
                <p>
                    Nhập thông tin để tiếp tục
                </p>
            </div>

            <form method="POST" action="/login">

                <div class="form-group">
                    <label>Email</label>
                    <div class="input-wrap">
                        ✉️
                        <input
                            type="email"
                            name="email"
                            placeholder="admin@soundmind.vn"
                            required
                        />
                    </div>
                </div>

                <div class="form-group">
                    <label>Mật khẩu</label>
                    <div class="input-wrap">
                        🔒
                        <input
                            type="password"
                            name="password"
                            placeholder="••••••••"
                            required
                        />
                    </div>
                </div>

                <button type="submit">
                    Đăng nhập
                </button>

            </form>

        </div>

    </div>

</div>

</body>
</html>