<% const placeholderAvatar = 'https://ui-avatars.com/api/?name=Author&background=eef2ff&color=4f46e5'; %>

<form method="POST" action="<%= action %>" class="author-form">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="form-section">
                <div class="section-title">
                    <i class="bi bi-person"></i>
                    Thong tin tac gia
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Ten tac gia</label>
                        <input
                            name="name"
                            value="<%= author.name || '' %>"
                            class="form-control form-field"
                            placeholder="Nhap ten tac gia"
                            required
                        >
                    </div>

                    <div class="col-12">
                        <label class="form-label">Anh dai dien</label>
                        <input
                            id="avatarInput"
                            name="avatar"
                            value="<%= author.avatar || '' %>"
                            class="form-control form-field"
                            placeholder="https://example.com/avatar.jpg"
                        >
                    </div>

                    <div class="col-12">
                        <label class="form-label">Tieu su</label>
                        <textarea
                            name="bio"
                            class="form-control form-field textarea-field"
                            placeholder="Nhap tieu su ngan"
                        ><%= author.bio || '' %></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="form-section side-section">
                <div class="section-title">
                    <i class="bi bi-image"></i>
                    Hien thi
                </div>

                <div class="avatar-preview">
                    <img id="avatarPreview" src="<%= author.avatar || placeholderAvatar %>" alt="Avatar tac gia">
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a href="<%= adminRoute %>/authors" class="btn-soft text-decoration-none">
                        <i class="bi bi-arrow-left"></i>
                        Quay lai
                    </a>

                    <button type="submit" class="btn-gradient flex-fill">
                        <i class="bi <%= submitIcon %>"></i>
                        <%= submitText %>
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    const avatarInput = document.getElementById('avatarInput');
    const avatarPreview = document.getElementById('avatarPreview');

    avatarInput.addEventListener('input', function () {
        avatarPreview.src = this.value || '<%= placeholderAvatar %>';
    });
</script>
