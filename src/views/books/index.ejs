<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Quản lý sách - SoundMind Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, #dbeafe, transparent 35%),
                radial-gradient(circle at bottom right, #e9d5ff, transparent 35%),
                #f8fafc;
            font-family: Inter, sans-serif;
            color: #0f172a;
        }

        .sidebar {
            width: 280px;
            min-height: 100vh;
            background: rgba(255, 255, 255, .72);
            backdrop-filter: blur(18px);
            border-right: 1px solid rgba(255, 255, 255, .7);
            padding: 28px;
            position: fixed;
            left: 0;
            top: 0;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 35px;
        }

        .brand-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            background: #eef2ff;
            color: #4f46e5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .brand-title {
            font-weight: 700;
            font-size: 20px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 18px;
            border-radius: 18px;
            color: #64748b;
            text-decoration: none;
            margin-bottom: 10px;
            transition: .25s;
        }

        .menu-item:hover {
            background: rgba(79, 70, 229, .08);
            color: #4f46e5;
        }

        .menu-item.active {
            background: linear-gradient(to right, #111827, #4f46e5);
            color: white;
            box-shadow: 0 10px 25px rgba(79, 70, 229, .22);
        }

        .content {
            margin-left: 280px;
            padding: 32px;
        }

        .glass-card {
            background: rgba(255, 255, 255, .72);
            backdrop-filter: blur(16px);
            border-radius: 28px;
            border: 1px solid rgba(255, 255, 255, .8);
            box-shadow: 0 15px 35px rgba(15, 23, 42, .06);
        }

        .topbar {
            padding: 22px 28px;
            margin-bottom: 28px;
        }

        .search-box {
            border: none;
            border-radius: 18px;
            padding: 14px 18px;
            background: #f8fafc;
        }

        .search-box:focus {
            background: #f1f5f9;
            box-shadow: none;
            border: none;
            outline: none;
        }

        .stat-card {
            padding: 24px;
            border-radius: 24px;
            height: 100%;
        }

        .stat-icon {
            width: 52px;
            height: 52px;
            border-radius: 18px;
            background: #eef2ff;
            color: #4f46e5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .table-card {
            padding: 28px;
            border-radius: 30px;
        }

        .table>:not(caption)>*>* {
            background: transparent;
            border-bottom-color: #eef2f7;
            vertical-align: middle;
        }

        .book-cover {
            width: 52px;
            height: 72px;
            object-fit: cover;
            border-radius: 14px;
        }

        .badge-status {
            border-radius: 999px;
            padding: 8px 14px;
            font-size: 12px;
            font-weight: 600;
        }

        .published {
            background: #dcfce7;
            color: #15803d;
        }

        .draft {
            background: #fef3c7;
            color: #b45309;
        }

        .hidden {
            background: #e2e8f0;
            color: #475569;
        }

        .btn-gradient {
            border: none;
            border-radius: 18px;
            padding: 12px 20px;
            color: white;
            font-weight: 600;
            background: linear-gradient(to right, #111827, #4f46e5);
        }

        .action-btn {
            width: 38px;
            height: 38px;
            border-radius: 14px;
            border: none;
            background: #f8fafc;
        }

        .pagination-wrapper {
            border-top: 1px solid #eef2f7;
            padding-top: 24px;
        }

        .pagination-glass {
            gap: 10px;
        }

        .pagination-glass .page-item {
            list-style: none;
        }

        .pagination-glass .page-link {
            min-width: 42px;
            height: 42px;
            border: none;
            border-radius: 14px;
            background: rgba(255, 255, 255, .72);
            backdrop-filter: blur(12px);
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            box-shadow:
                0 8px 20px rgba(15, 23, 42, .05);
            transition: .25s;
            padding: 0 16px;
        }

        .pagination-glass .page-link:hover {
            background: rgba(79, 70, 229, .08);
            color: #4f46e5;
            transform: translateY(-1px);
        }

        .pagination-glass .page-item.active .page-link {
            background:
                linear-gradient(to right,
                    #111827,
                    #4f46e5);
            color: white;
            box-shadow:
                0 10px 25px rgba(79, 70, 229, .25);
        }

        .pagination-glass .page-item.disabled .page-link {
            opacity: .45;
            pointer-events: none;
        }

        .pagination-info {
            color: #64748b;
            font-size: 14px;
        }

        @media(max-width:992px) {
            .sidebar {
                display: none;
            }

            .content {
                margin-left: 0;
            }
        }
    </style>
</head>

<body>
    <div class="sidebar">

        <div class="brand">
            <div class="brand-icon">
                <i class="bi bi-soundwave"></i>
            </div>

            <div>
                <div class="brand-title">SoundMind</div>
                <small class="text-secondary">Admin Panel</small>
            </div>
        </div>

        <a href="#" class="menu-item active">
            <i class="bi bi-book"></i>
            Quản lý sách
        </a>

        <a href="#" class="menu-item">
            <i class="bi bi-tags"></i>
            Thể loại
        </a>

        <a href="#" class="menu-item">
            <i class="bi bi-people"></i>
            Người dùng
        </a>

        <a href="#" class="menu-item">
            <i class="bi bi-gear"></i>
            Cài đặt
        </a>

        <a href="#" class="menu-item mt-4">
            <i class="bi bi-box-arrow-right"></i>
            Đăng xuất
        </a>

    </div>

    <div class="content">

        <div class="glass-card topbar d-flex justify-content-between align-items-center">

            <div>
                <h3 class="fw-bold mb-1">Quản lý thư viện sách</h3>
                <div class="text-secondary">Dashboard / Books</div>
            </div>

            <div class="d-flex gap-3 align-items-center">
                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center"
                    style="width:48px;height:48px;">
                    <i class="bi bi-bell"></i>
                </div>

                <img src="https://i.pravatar.cc/100" width="48" height="48" class="rounded-circle">
            </div>

        </div>

        <div class="glass-card table-card">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div class="d-flex gap-3">

                    <form method="GET" action="/books" class="d-flex gap-3 align-items-center">
                        <input type="hidden" name="page" value="0">
                        <input type="hidden" name="size" value="<%= filters.size || 10 %>">

                        <input name="search" value="<%= filters.search || '' %>" class="form-control search-box"
                            placeholder="Tìm sách ...">

                        <select name="categoryId" class="form-select search-box" onchange="this.form.submit()">
                            <option value="">Tất cả thể loại</option>

                            <% categories.forEach(category=> { %>
                                <% const id=category.id ?? category._id ?? category.categoryId; %>
                                    <% const name=category.name ?? category.title ?? category.categoryName ??
                                        category.slug ?? `#${id}`; %>

                                        <option value="<%= id %>" <%=String(filters.categoryId || '' )===String(id)
                                            ? 'selected' : '' %>>
                                            <%= name %>
                                        </option>
                                        <% }) %>
                        </select>

                        <button type="submit" class="btn-gradient">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>

                </div>

                <a href="/books/create" class="btn-gradient text-decoration-none">
                    <i class="bi bi-plus-lg"></i>
                    Thêm sách
                </a>

            </div>

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr class="text-secondary">
                            <th>Sách</th>
                            <th>Tác giả</th>
                            <th>Thể loại</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        <% if (books && books.length> 0) { %>

                            <% books.forEach(book=> { %>

                                <tr>

                                    <td>
                                        <div class="d-flex gap-3 align-items-center">

                                            <img class="book-cover" src="<%= book.coverImage %>"
                                                alt="<%= book.title %>">

                                            <div>
                                                <div class="fw-semibold">
                                                    <%= book.title %>
                                                </div>

                                                <small class="text-secondary">
                                                    <%= book.totalDuration %> phút
                                                </small>
                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        <%= book.authorName %>
                                    </td>

                                    <td>
                                        <%= categoryMap[book.categoryId] || book.categoryName || `#${book.categoryId}`
                                            %>
                                    </td>

                                    <td>

                                        <% if(book.isPremium){ %>

                                            <span class="badge-status published">
                                                Premium
                                            </span>

                                            <% } else { %>

                                                <span class="badge-status draft">
                                                    Free
                                                </span>

                                                <% } %>

                                    </td>

                                    <td>
                                        <%= new Date(book.createdAt) .toLocaleDateString('vi-VN') %>
                                    </td>

                                    <td>

                                        <div class="d-flex gap-2">

                                            <a href="/books/<%= book.id %>"
                                                class="action-btn d-flex align-items-center justify-content-center text-dark text-decoration-none">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a href="/books/<%= book.id %>/edit"
                                                class="action-btn d-flex align-items-center justify-content-center text-dark text-decoration-none">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <button class="action-btn">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </div>

                                    </td>

                                </tr>

                                <% }) %>

                                    <% } else { %>

                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-secondary">
                                                Không có dữ liệu sách
                                            </td>
                                        </tr>

                                        <% } %>

                    </tbody>

                </table>

            </div>

            <% const currentPage=pagination.page || 0; const totalPages=pagination.totalPages || 1; %>

                <div class="d-flex justify-content-between align-items-center mt-4">

                    <div class="text-secondary small">
                        Tổng:
                        <strong>
                            <%= pagination.totalElements %>
                        </strong>
                        sách
                    </div>

                    <nav>

                        <ul class="pagination pagination-glass mb-0">

                            <!-- Prev -->
                            <li class="page-item <%= currentPage === 0 ? 'disabled' : '' %>">
                                <a class="page-link"
                                    href="/books?page=<%= currentPage - 1 %>&size=<%= filters.size %>&search=<%= filters.search || '' %>&categoryId=<%= filters.categoryId || '' %>">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            <!-- Pages -->
                            <% for(let i=0;i<totalPages;i++){ %>

                                <li class="page-item <%= currentPage === i ? 'active' : '' %>">

                                    <a class="page-link"
                                        href="/books?page=<%= i %>&size=<%= filters.size %>&search=<%= filters.search || '' %>&categoryId=<%= filters.categoryId || '' %>">
                                        <%= i + 1 %>
                                    </a>

                                </li>

                                <% } %>

                                    <!-- Next -->
                                    <li class="page-item <%= currentPage >= totalPages - 1 ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="/books?page=<%= currentPage + 1 %>&size=<%= filters.size %>&search=<%= filters.search || '' %>&categoryId=<%= filters.categoryId || '' %>">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>

                        </ul>

                    </nav>

                </div>
        </div>



    </div>

</body>

</html>