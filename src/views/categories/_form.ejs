<form method="POST" action="<%= action %>" class="category-form">
    <div class="form-section">
        <div class="section-title">
            <i class="bi bi-tags"></i>
            Thong tin the loai
        </div>

        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">Ten the loai</label>
                <input
                    name="name"
                    value="<%= category.name || '' %>"
                    class="form-control form-field"
                    placeholder="Nhap ten the loai"
                    required
                >
            </div>

            <div class="col-12">
                <label class="form-label">Mo ta</label>
                <textarea
                    name="description"
                    class="form-control form-field textarea-field"
                    placeholder="Nhap mo ta ngan"
                ><%= category.description || '' %></textarea>
            </div>
        </div>

        <div class="d-flex gap-3 mt-4">
            <a href="/categories" class="btn-soft text-decoration-none">
                <i class="bi bi-arrow-left"></i>
                Quay lai
            </a>

            <button type="submit" class="btn-gradient">
                <i class="bi <%= submitIcon %>"></i>
                <%= submitText %>
            </button>
        </div>
    </div>
</form>
