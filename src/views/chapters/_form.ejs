<% const selectedBookId = chapter.bookId ?? chapter.book?.id ?? ''; %>

<form method="POST" action="<%= action %>" class="chapter-form">
    <div class="form-section">
        <div class="section-title">
            <i class="bi bi-music-note-list"></i>
            Thong tin chuong sach
        </div>

        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Ten chuong</label>
                <input name="title" value="<%= chapter.title || '' %>" class="form-control form-field"
                    placeholder="Nhap ten chuong" required>
            </div>

            <div class="col-md-4">
                <label class="form-label">So thu tu</label>
                <input name="chapterNumber" type="number" min="1" value="<%= chapter.chapterNumber || '' %>"
                    class="form-control form-field" placeholder="1" required>
            </div>

            <div class="col-md-8">
                <label class="form-label">Sach</label>
                <select name="bookId" class="form-select form-field" required>
                    <option value="">Chon sach</option>
                    <% books.forEach(book => { %>
                        <% const id = book.id ?? book._id ?? book.bookId; %>
                        <option value="<%= id %>" <%= String(selectedBookId) === String(id) ? 'selected' : '' %>>
                            <%= book.title || `#${id}` %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Thoi luong</label>
                <input name="duration" type="number" min="0" value="<%= chapter.duration || '' %>"
                    class="form-control form-field" placeholder="Giay">
            </div>

            <div class="col-12">
                <label class="form-label">Audio URL</label>
                <input name="audioUrl" value="<%= chapter.audioUrl || '' %>" class="form-control form-field"
                    placeholder="https://example.com/audio.mp3" required>
            </div>
        </div>

        <div class="d-flex gap-3 mt-4">
            <a href="<%= adminRoute %>/chapters" class="btn-soft text-decoration-none">
                <i class="bi bi-arrow-left"></i>
                Quay lai
            </a>

            <button type="submit" class="btn-gradient">
                <i class="bi <%= submitIcon %>"></i>
                <%= submitText %>
            </button>
        </div>
    </div>
</form>
