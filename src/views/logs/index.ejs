<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>System Logs Monitor - SoundMind Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, #dbeafe, transparent 35%),
                radial-gradient(circle at bottom right, #e9d5ff, transparent 35%),
                #f8fafc;
            font-family: Inter, sans-serif;
            color: #0f172a;
        }

        .sidebar {
            width: 280px;
            min-height: 100vh;
            background: rgba(255, 255, 255, .72);
            backdrop-filter: blur(18px);
            border-right: 1px solid rgba(255, 255, 255, .7);
            padding: 28px;
            position: fixed;
            left: 0;
            top: 0;
            z-index: 100;
        }

        .content {
            margin-left: 280px;
            padding: 32px;
        }

        .glass-card {
            background: rgba(255, 255, 255, .72);
            backdrop-filter: blur(16px);
            border-radius: 28px;
            border: 1px solid rgba(255, 255, 255, .8);
            box-shadow: 0 15px 35px rgba(15, 23, 42, .06);
        }

        .topbar {
            padding: 22px 28px;
            margin-bottom: 28px;
        }

        .btn-gradient {
            border: none;
            border-radius: 16px;
            padding: 10px 20px;
            color: white;
            font-weight: 600;
            background: linear-gradient(to right, #111827, #4f46e5);
            transition: all 0.2s ease;
        }

        .btn-gradient:hover {
            opacity: 0.95;
            color: white;
            transform: translateY(-1px);
        }

        .search-box {
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 16px;
            padding: 10px 16px;
            background: rgba(255, 255, 255, 0.9);
            font-size: 14px;
        }

        .search-box:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
            border-color: #6366f1;
        }

        /* --- TERMINAL SPECIFIC STYLES --- */
        .terminal-container {
            background: #0f172a;
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 40px rgba(15, 23, 42, 0.25);
            overflow: hidden;
        }

        .terminal-header {
            background: rgba(30, 41, 59, 0.8);
            backdrop-filter: blur(10px);
            padding: 14px 24px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .terminal-dots {
            display: flex;
            gap: 8px;
        }

        .terminal-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }

        .dot-red {
            background: #ef4444;
        }

        .dot-yellow {
            background: #f59e0b;
        }

        .dot-green {
            background: #10b981;
        }

        .terminal-body {
            height: 600px;
            overflow-y: auto;
            padding: 20px;
            font-family: 'Fira Code', 'Courier New', Courier, monospace;
            font-size: 13px;
            line-height: 1.6;
            color: #e2e8f0;
            background: #020617;
            scroll-behavior: smooth;
        }

        /* Custom Scrollbar cho Terminal */
        .terminal-body::-webkit-scrollbar {
            width: 8px;
        }

        .terminal-body::-webkit-scrollbar-track {
            background: #090d16;
        }

        .terminal-body::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }

        .terminal-body::-webkit-scrollbar-thumb:hover {
            background: #334155;
        }

        .log-row {
            display: flex;
            gap: 12px;
            padding: 4px 8px;
            border-radius: 6px;
            transition: background 0.15s ease;
        }

        .log-row:hover {
            background: rgba(255, 255, 255, 0.04);
        }

        .log-time {
            color: #64748b;
            flex-shrink: 0;
            user-select: none;
        }

        .log-badge {
            font-weight: 700;
            padding: 0 6px;
            border-radius: 4px;
            font-size: 11px;
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            height: 20px;
            margin-top: 2px;
        }

        .badge-info {
            background: rgba(59, 130, 246, 0.2);
            color: #60a5fa;
            border: 1px solid rgba(96, 165, 250, 0.3);
        }

        .badge-warn {
            background: rgba(245, 158, 11, 0.2);
            color: #fbbf24;
            border: 1px solid rgba(251, 191, 36, 0.3);
        }

        .badge-error {
            background: rgba(239, 68, 68, 0.2);
            color: #f87171;
            border: 1px solid rgba(248, 113, 113, 0.3);
        }

        .log-msg {
            word-break: break-all;
            color: #cbd5e1;
        }

        .action-icon-btn {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

        .action-icon-btn:hover {
            background: rgba(255, 255, 255, 0.18);
            color: #fff;
        }
    </style>
</head>

<body>
    <%- include('../partials/sidebar', { active: 'logs' }) %>

        <div class="content">
            <!-- Header đơn giản -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1"><i class="bi bi-terminal-fill text-indigo me-2"></i>System Logs Monitor
                    </h4>
                    <p class="text-muted mb-0 small">Theo dõi log thời gian thực từ Loki & Promtail Server</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span
                        class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                        <i class="bi bi-circle-fill me-1 small"></i> Live Stream
                    </span>
                </div>
            </div>

            <!-- Toolbar Controls -->
            <div class="glass-card p-4 mb-4">
                <div class="row g-3 align-items-center">
                    <!-- Select Service -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-secondary small">Container / App Service</label>

                        <select id="containerSelect" class="form-select search-box fw-semibold">
                            <option value="soundmind-api" selected>soundmind-api (Backend)</option>
                            <option value="soundmind-admin">soundmind-admin (Dashboard)</option>
                        </select>
                    </div>

                    <!-- Filter Keyword -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-secondary small">Lọc từ khóa</label>

                        <div class="input-group">
                            <input type="text" id="filterInput" class="form-control search-box"
                                placeholder="Nhập từ khóa (VD: error, 500, /api)...">
                        </div>
                    </div>

                    <!-- Select Limit -->
                    <div class="col-md-2">
                        <label class="form-label fw-semibold text-secondary small">Số dòng log</label>

                        <select id="limitSelect" class="form-select search-box">
                            <option value="50">50 dòng</option>
                            <option value="100" selected>100 dòng</option>
                            <option value="200">200 dòng</option>
                            <option value="500">500 dòng</option>
                        </select>
                    </div>

                    <!-- Action Buttons -->
                    <div class="col-md-3 d-flex align-items-end gap-2 justify-content-end">
                        <button id="btnRefresh" class="btn btn-gradient d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-clockwise" id="refreshIcon"></i> Làm mới
                        </button>
                    </div>
                </div>
            </div>

            <!-- Terminal Output Screen -->
            <div class="terminal-container">
                <!-- Terminal Header -->
                <div class="terminal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="terminal-dots">
                            <div class="terminal-dot dot-red"></div>
                            <div class="terminal-dot dot-yellow"></div>
                            <div class="terminal-dot dot-green"></div>
                        </div>
                        <span class="text-secondary small font-monospace" id="terminalTitle">bash -
                            soundmind-api@vps</span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <!-- Auto Scroll Toggle -->
                        <button class="action-icon-btn" id="btnAutoScroll" title="Bật/Tắt Tự động cuộn xuống"
                            onclick="toggleAutoScroll()">
                            <i class="bi bi-arrow-down-circle-fill text-info"></i>
                        </button>

                        <!-- Clear Console -->
                        <button class="action-icon-btn" title="Xóa màn hình" onclick="clearConsole()">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>

                <!-- Terminal Content -->
                <div class="terminal-body" id="logTerminal">
                    <div id="logContent">
                        <div class="text-secondary p-3">Đang kết nối tới Loki Server...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Script Xử lý Realtime Fetching -->
        <script>
            let autoScroll = true;
            let allLogs = [];

            async function fetchLogs() {
                const container = document.getElementById('containerSelect').value;
                const limit = document.getElementById('limitSelect').value;
                const refreshIcon = document.getElementById('refreshIcon');

                refreshIcon.classList.add('spin-animation');
                document.getElementById('terminalTitle').innerText = `bash - ${container}@vps`;

                try {
                    const res = await fetch(`<%= adminRoute %>/logs/api?container=${container}&limit=${limit}`);
                    const result = await res.json();

                    if (result.success) {
                        allLogs = result.data;
                        renderLogs();
                    } else {
                        document.getElementById('logContent').innerHTML = `
                        <div class="text-danger p-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>${result.message}</div>
                    `;
                    }
                } catch (err) {
                    document.getElementById('logContent').innerHTML = `
                    <div class="text-danger p-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>Lỗi kết nối API Admin: ${err.message}</div>
                `;
                } finally {
                    refreshIcon.classList.remove('spin-animation');
                }
            }

            function renderLogs() {
                const filterValue = document.getElementById('filterInput').value.toLowerCase();
                const logContent = document.getElementById('logContent');

                const filtered = allLogs.filter(log => log.message.toLowerCase().includes(filterValue));

                if (filtered.length === 0) {
                    logContent.innerHTML = `<div class="text-warning p-3">Không tìm thấy dòng log nào khớp với từ khóa.</div>`;
                    return;
                }

                logContent.innerHTML = filtered.map(log => {
                    let badgeClass = 'badge-info';
                    if (log.level === 'ERROR') badgeClass = 'badge-error';
                    if (log.level === 'WARN') badgeClass = 'badge-warn';

                    return `
                    <div class="log-row">
                        <span class="log-time">[${log.timeFormatted}]</span>
                        <span class="log-badge ${badgeClass}">${log.level}</span>
                        <span class="log-msg">${escapeHtml(log.message)}</span>
                    </div>
                `;
                }).join('');

                if (autoScroll) {
                    const terminal = document.getElementById('logTerminal');
                    terminal.scrollTop = terminal.scrollHeight;
                }
            }

            function clearConsole() {
                document.getElementById('logContent').innerHTML = '<div class="text-secondary p-3">Màn hình đã được dọn dẹp. Bấm "Làm mới" để tải lại log.</div>';
            }

            function toggleAutoScroll() {
                autoScroll = !autoScroll;
                const btn = document.getElementById('btnAutoScroll');
                if (autoScroll) {
                    btn.innerHTML = '<i class="bi bi-arrow-down-circle-fill text-info"></i>';
                } else {
                    btn.innerHTML = '<i class="bi bi-arrow-down-circle text-secondary"></i>';
                }
            }

            function escapeHtml(text) {
                return text
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;");
            }

            document.addEventListener('DOMContentLoaded', () => {
                const btnRefresh = document.getElementById('btnRefresh');
                const refreshIcon = document.getElementById('refreshIcon');

                // Hàm handler chung cho cả nút và icon
                const handleRefresh = (e) => {
                    e.preventDefault();
                    e.stopPropagation(); // Ngăn sự kiện bị trigger 2 lần
                    fetchLogs();
                };

                // Lắng nghe click trên cả Nút và Icon
                if (btnRefresh) btnRefresh.addEventListener('click', handleRefresh);
                if (refreshIcon) refreshIcon.addEventListener('click', handleRefresh);

                // Các listener khác
                document.getElementById('containerSelect')?.addEventListener('change', fetchLogs);
                document.getElementById('limitSelect')?.addEventListener('change', fetchLogs);
                document.getElementById('filterInput')?.addEventListener('input', renderLogs);

                fetchLogs();
            });

        </script>

        <style>
            .spin-animation {
                animation: spin 0.8s linear infinite;
            }

            @keyframes spin {
                100% {
                    transform: rotate(360deg);
                }
            }
        </style>
</body>

</html>