<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý orders - SoundMind Admin</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

  <style>
    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at top left, #dbeafe, transparent 35%),
        radial-gradient(circle at bottom right, #e9d5ff, transparent 35%),
        #f8fafc;
      font-family: Inter, sans-serif;
      color: #0f172a;
    }

    .sidebar {
      width: 280px;
      min-height: 100vh;
      background: rgba(255, 255, 255, .72);
      backdrop-filter: blur(18px);
      border-right: 1px solid rgba(255, 255, 255, .7);
      padding: 28px;
      position: fixed;
      left: 0;
      top: 0;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 35px;
    }

    .brand-icon {
      width: 48px;
      height: 48px;
      border-radius: 16px;
      background: #eef2ff;
      color: #4f46e5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }

    .brand-title {
      font-weight: 700;
      font-size: 20px;
    }

    .menu-item {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px 18px;
      border-radius: 18px;
      color: #64748b;
      text-decoration: none;
      margin-bottom: 10px;
    }

    .menu-item.active {
      background: linear-gradient(to right, #111827, #4f46e5);
      color: white;
    }

    .content {
      margin-left: 280px;
      padding: 32px;
    }

    .glass-card {
      background: rgba(255, 255, 255, .72);
      backdrop-filter: blur(16px);
      border-radius: 28px;
      border: 1px solid rgba(255, 255, 255, .8);
      box-shadow: 0 15px 35px rgba(15, 23, 42, .06);
    }

    .topbar {
      padding: 22px 28px;
      margin-bottom: 28px;
    }

    .table-card {
      padding: 28px;
    }

    .btn-gradient {
      border: none;
      border-radius: 18px;
      padding: 12px 20px;
      color: white;
      font-weight: 600;
      background: linear-gradient(to right, #111827, #4f46e5);
    }

    .search-box {
      border: none;
      border-radius: 18px;
      padding: 14px 18px;
      background: #f8fafc;
    }

    .badge-status {
      padding: 8px 12px;
      border-radius: 12px;
      font-weight: 600;
    }

    .active-status {
      background: #dcfce7;
      color: #166534;
    }

    .pending-status {
      background: #fde68a;
      color: #92400e;
    }

    .action-btn {
      width: 38px;
      height: 38px;
      border: none;
      border-radius: 14px;
      background: #f8fafc;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: #0f172a;
    }

    .pagination-glass .page-link {
      min-width: 42px;
      height: 42px;
      border: none;
      border-radius: 14px;
      background: rgba(255, 255, 255, .72);
      color: #64748b;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      padding: 0 16px;
    }

    .pagination-glass .page-item.active .page-link {
      background: linear-gradient(to right, #111827, #4f46e5);
      color: white;
    }

    .pagination-glass .page-item.disabled .page-link {
      opacity: .45;
      pointer-events: none;
    }
  </style>
</head>

<body>

  <%- include('../partials/sidebar', { active: 'orders' }) %>

    <div class="content">

      <div class="glass-card topbar d-flex justify-content-between align-items-center">
        <div>
          <h3 class="fw-bold mb-1">
            Quản lý orders
          </h3>

          <div class="text-secondary">
            Dashboard / Orders
          </div>
        </div>
      </div>

      <% if(typeof error !=='undefined' && error){ %>
        <div class="alert alert-danger rounded-4 border-0">
          <%= error %>
        </div>
        <% } %>

          <div class="glass-card table-card">

            <div class="d-flex justify-content-between align-items-center mb-4">
              <form method="GET" action="<%= adminRoute %>/orders" class="d-flex gap-3">
                <input type="hidden" name="page" value="0">
                <input type="hidden" name="size" value="<%= filters.size || 10 %>">

                <input name="search" value="<%= filters.search || '' %>" class="form-control search-box"
                  placeholder="Tìm orders...">

                <button class="btn-gradient">
                  <i class="bi bi-search"></i>
                </button>
              </form>
            </div>

            <div class="table-responsive">
              <table class="table align-middle">

                <thead>
                  <tr class="text-secondary">
                    <th>Order ID</th>
                    <th>Invoice</th>
                    <th>Khách hàng</th>
                    <th>Số tiền</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th></th>
                  </tr>
                </thead>

                <tbody>

                  <% if(orders && orders.length> 0){ %>

                    <% orders.forEach(order=> { %>

                      <% const status=(order.status || '' ).toUpperCase(); const
                        isActive=['ACTIVE','COMPLETED'].includes(status); %>

                        <tr>

                          <td>
                            <div class="fw-semibold">
                              <%= order.orderId || order.id || '-' %>
                            </div>
                          </td>

                          <td>
                            <%= order.invoiceNumber || '-' %>
                          </td>

                          <td>
                            <div class="fw-semibold">
                              <%= order.user?.name || '-' %>
                            </div>

                            <small class="text-secondary d-block">
                              <%= order.user?.email || '-' %>
                            </small>
                          </td>

                          <td>
                            <%= order.amount !=null ? `${order.amount} ${order.currency || 'VND' }` : '-' %>
                          </td>

                          <td>
                            <span class="badge-status <%= isActive ? 'active-status' : 'pending-status' %>">
                              <%= order.status || '-' %>
                            </span>
                          </td>

                          <td>
                            <%= (order.createdAt || order.createdDate) ? (order.createdAt ||
                              order.createdDate).split('T')[0] : '-' %>
                          </td>

                          <td>
                            <div class="d-flex gap-2 justify-content-end">

                              <a href="<%= adminRoute %>/orders/<%= order.id || order.orderId %>" class="action-btn">
                                <i class="bi bi-eye"></i>
                              </a>

                              <a href="<%= adminRoute %>/orders/<%= order.id || order.orderId %>/edit" class="action-btn">
                                <i class="bi bi-pencil"></i>
                              </a>

                            </div>
                          </td>

                        </tr>

                        <% }) %>

                          <% } else { %>

                            <tr>
                              <td colspan="7" class="text-center py-5 text-secondary">
                                Không có dữ liệu orders
                              </td>
                            </tr>

                            <% } %>

                </tbody>

              </table>
            </div>

            <%- include('../partials/pagination', { baseUrl: '/orders' , totalLabel: 'đơn' }) %>

          </div>

    </div>

</body>

</html>