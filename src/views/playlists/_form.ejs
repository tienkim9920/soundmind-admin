<form method="POST" action="<%= action %>" class="playlist-form">
    <% const selectedBookIds=new Set((playlist.books || []).map(book=> book.id ?? book._id ?? book.bookId)); %>
        <div class="row g-4">

            <div class="col-lg-8">
                <div class="form-section">

                    <div class="section-title">
                        <i class="bi bi-music-note-list"></i>
                        Thông tin playlist
                    </div>

                    <div class="row g-3">

                        <div class="col-12">
                            <label class="form-label">
                                Tên playlist
                            </label>

                            <input name="name" type="text" value="<%= playlist.name || '' %>"
                                class="form-control form-field" placeholder="Nhập tên playlist" required>
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Ảnh bìa URL
                            </label>

                            <input name="image" type="text" value="<%= playlist.image || '' %>"
                                class="form-control form-field" placeholder="Nhập URL ảnh bìa">
                        </div>

                        <div class="col-12">
                            <label class="form-label">
                                Mô tả
                            </label>

                            <textarea name="description" class="form-control form-field" rows="4"
                                placeholder="Nhập mô tả playlist"><%= playlist.description || '' %></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Chọn sách trong playlist</label>

                            <!-- Ô tìm kiếm -->
                            <input type="text" id="bookSearch" class="form-control mb-2"
                                placeholder="Nhập tên sách để tìm...">

                            <select id="bookSelect" name="bookIds" class="form-select form-field" multiple size="8">

                                <% (books || []).forEach((book)=> { %>
                                    <% const bookId=book.id ?? book._id ?? book.bookId; %>
                                        <% const bookTitle=book.title || book.name || `#${bookId}`; %>
                                            <!-- Thêm data-text để JS đọc chính xác tên sách không dấu/có dấu -->
                                            <option value="<%= bookId %>" data-text="<%= bookTitle.toLowerCase() %>"
                                                <%=selectedBookIds.has(bookId) ? 'selected' : '' %>>
                                                <%= bookTitle %>
                                            </option>
                                            <% }) %>

                            </select>

                            <small class="text-secondary">
                                Giữ Ctrl hoặc Cmd để chọn nhiều sách.
                            </small>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check mt-3">
                                <input class="form-check-input" type="checkbox" name="isFeatured" id="isFeatured"
                                    <%=playlist.isFeatured ? 'checked' : '' %>
                                >
                                <label class="form-check-label" for="isFeatured">
                                    Nổi bật
                                </label>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="form-section side-section">

                    <div class="section-title">
                        <i class="bi bi-eye"></i>
                        Xem trước
                    </div>

                    <div class="p-4 rounded-4 bg-light border">

                        <div class="fw-semibold mb-2">
                            Tên playlist:
                            <span id="previewTitle">
                                <%= playlist.name || '-' %>
                            </span>
                        </div>

                        <div class="mb-2 text-secondary">
                            Ảnh bìa:
                            <span id="previewImage">
                                <%= playlist.image || '-' %>
                            </span>
                        </div>

                        <div class="text-secondary">
                            Nổi bật:
                            <span id="previewFeatured">
                                <%= playlist.isFeatured ? 'Có' : 'Không' %>
                            </span>
                        </div>

                    </div>

                    <div class="d-flex gap-3 mt-4">

                        <a href="<%= adminRoute %>/playlists" class="btn-soft text-decoration-none">
                            <i class="bi bi-arrow-left"></i>
                            Quay lại
                        </a>

                        <button type="submit" class="btn-gradient flex-fill">

                            <i class="bi <%= submitIcon %>"></i>
                            <%= submitText %>

                        </button>
                    </div>

                </div>
            </div>

        </div>
</form>

<script>
    const titleInput = document.querySelector('[name="name"]');
    const imageInput = document.querySelector('[name="image"]');
    const featuredInput = document.querySelector('[name="isFeatured"]');

    const previewTitle = document.getElementById('previewTitle');
    const previewImage = document.getElementById('previewImage');
    const previewFeatured = document.getElementById('previewFeatured');

    titleInput?.addEventListener('input', function () {
        previewTitle.textContent = this.value || '-';
    });

    imageInput?.addEventListener('input', function () {
        previewImage.textContent = this.value || '-';
    });

    featuredInput?.addEventListener('change', function () {
        previewFeatured.textContent = this.checked ? 'Có' : 'Không';
    });

    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById('bookSearch');
        const select = document.getElementById('bookSelect');

        // Lưu lại bản sao của toàn bộ options ban đầu
        const allOptions = Array.from(select.options);

        searchInput.addEventListener('input', function () {
            const filterValue = this.value.trim().toLowerCase();

            // 1. Lưu lại các giá trị đang được chọn hiện tại để không bị mất khi lọc
            const selectedValues = Array.from(select.options)
                .filter(opt => opt.selected)
                .map(opt => opt.value);

            // 2. Xóa sạch các option hiện tại trong select
            select.innerHTML = '';

            // 3. Lọc và thêm lại các option thỏa mãn điều kiện tìm kiếm
            allOptions.forEach(option => {
                const text = option.getAttribute('data-text') || '';

                // Nếu tìm thấy từ khóa HOẶC option đó đang được chọn (để tránh bị mất dữ liệu khi submit)
                if (text.includes(filterValue) || selectedValues.includes(option.value)) {
                    // Giữ trạng thái selected nếu trước đó người dùng đã chọn
                    if (selectedValues.includes(option.value)) {
                        option.selected = true;
                    }
                    select.appendChild(option);
                }
            });
        });
    });
</script>