<form method="POST" action="<%= action %>" class="playlist-form">
    <% const selectedBookIds = new Set((playlist.books || []).map(book => book.id ?? book._id ?? book.bookId)); %>
    <div class="row g-4">

        <div class="col-lg-8">
            <div class="form-section">

                <div class="section-title">
                    <i class="bi bi-music-note-list"></i>
                    Thông tin playlist
                </div>

                <div class="row g-3">

                    <div class="col-12">
                        <label class="form-label">
                            Tên playlist
                        </label>

                        <input
                            name="name"
                            type="text"
                            value="<%= playlist.name || '' %>"
                            class="form-control form-field"
                            placeholder="Nhập tên playlist"
                            required
                        >
                    </div>

                    <div class="col-12">
                        <label class="form-label">
                            Ảnh bìa URL
                        </label>

                        <input
                            name="image"
                            type="text"
                            value="<%= playlist.image || '' %>"
                            class="form-control form-field"
                            placeholder="Nhập URL ảnh bìa"
                        >
                    </div>

                    <div class="col-12">
                        <label class="form-label">
                            Mô tả
                        </label>

                        <textarea
                            name="description"
                            class="form-control form-field"
                            rows="4"
                            placeholder="Nhập mô tả playlist"><%= playlist.description || '' %></textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label">
                            Chọn sách trong playlist
                        </label>

                        <select
                            name="bookIds"
                            class="form-select form-field"
                            multiple
                            size="8">

                            <% (books || []).forEach((book) => { %>
                                <% const bookId = book.id ?? book._id ?? book.bookId; %>
                                <option value="<%= bookId %>" <%= selectedBookIds.has(bookId) ? 'selected' : '' %>>
                                    <%= book.title || book.name || `#${bookId}` %>
                                </option>
                            <% }) %>

                        </select>

                        <small class="text-secondary">
                            Giữ Ctrl hoặc Cmd để chọn nhiều sách.
                        </small>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check mt-3">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                name="isFeatured"
                                id="isFeatured"
                                <%= playlist.isFeatured ? 'checked' : '' %>
                            >
                            <label class="form-check-label" for="isFeatured">
                                Nổi bật
                            </label>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="form-section side-section">

                <div class="section-title">
                    <i class="bi bi-eye"></i>
                    Xem trước
                </div>

                <div class="p-4 rounded-4 bg-light border">

                    <div class="fw-semibold mb-2">
                        Tên playlist:
                        <span id="previewTitle">
                            <%= playlist.name || '-' %>
                        </span>
                    </div>

                    <div class="mb-2 text-secondary">
                        Ảnh bìa:
                        <span id="previewImage">
                            <%= playlist.image || '-' %>
                        </span>
                    </div>

                    <div class="text-secondary">
                        Nổi bật:
                        <span id="previewFeatured">
                            <%= playlist.isFeatured ? 'Có' : 'Không' %>
                        </span>
                    </div>

                </div>

                <div class="d-flex gap-3 mt-4">

                    <a
                        href="/playlists"
                        class="btn-soft text-decoration-none">
                        <i class="bi bi-arrow-left"></i>
                        Quay lại
                    </a>

                    <button
                        type="submit"
                        class="btn-gradient flex-fill">

                        <i class="bi <%= submitIcon %>"></i>
                        <%= submitText %>

                    </button>
                </div>

            </div>
        </div>

    </div>
</form>

<script>
    const titleInput = document.querySelector('[name="name"]');
    const imageInput = document.querySelector('[name="image"]');
    const featuredInput = document.querySelector('[name="isFeatured"]');

    const previewTitle = document.getElementById('previewTitle');
    const previewImage = document.getElementById('previewImage');
    const previewFeatured = document.getElementById('previewFeatured');

    titleInput?.addEventListener('input', function () {
        previewTitle.textContent = this.value || '-';
    });

    imageInput?.addEventListener('input', function () {
        previewImage.textContent = this.value || '-';
    });

    featuredInput?.addEventListener('change', function () {
        previewFeatured.textContent = this.checked ? 'Có' : 'Không';
    });
</script>