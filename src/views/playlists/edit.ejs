<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Chỉnh sửa playlist - SoundMind Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, #dbeafe, transparent 35%),
                radial-gradient(circle at bottom right, #e9d5ff, transparent 35%),
                #f8fafc;
            font-family: Inter, sans-serif;
            color: #0f172a;
        }

        .sidebar {
            width: 280px;
            min-height: 100vh;
            background: rgba(255, 255, 255, .72);
            backdrop-filter: blur(18px);
            border-right: 1px solid rgba(255, 255, 255, .7);
            padding: 28px;
            position: fixed;
            left: 0;
            top: 0;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 35px;
        }

        .brand-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            background: #eef2ff;
            color: #4f46e5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .brand-title {
            font-weight: 700;
            font-size: 20px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 18px;
            border-radius: 18px;
            color: #64748b;
            text-decoration: none;
            margin-bottom: 10px;
        }

        .menu-item.active {
            background: linear-gradient(to right, #111827, #4f46e5);
            color: white;
            box-shadow: 0 10px 25px rgba(79, 70, 229, .22);
        }

        .content {
            margin-left: 280px;
            padding: 32px;
        }

        .glass-card {
            background: rgba(255, 255, 255, .72);
            backdrop-filter: blur(16px);
            border-radius: 28px;
            border: 1px solid rgba(255, 255, 255, .8);
            box-shadow: 0 15px 35px rgba(15, 23, 42, .06);
        }

        .topbar {
            padding: 22px 28px;
            margin-bottom: 28px;
        }

        .btn-soft {
            border: none;
            border-radius: 18px;
            padding: 12px 18px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #475569;
            background: #f8fafc;
        }

        @media(max-width:992px) {
            .sidebar {
                display: none;
            }

            .content {
                margin-left: 0;
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/sidebar', { active: 'playlists' }) %>

  <div class="content">

        <div class="glass-card topbar d-flex justify-content-between align-items-center">

            <div>
                <h3 class="fw-bold mb-1">
                    Chỉnh sửa playlist
                </h3>

                <div class="text-secondary">
                    Dashboard / Playlists / Edit
                </div>
            </div>

            <a href="/playlists" class="btn-soft text-decoration-none">

                <i class="bi bi-arrow-left"></i>
                Danh sách
            </a>

        </div>

        <% if (typeof error !=='undefined' && error) { %>

            <div class="alert alert-danger rounded-4 border-0">
                <%= error %>
            </div>

        <% } %>

        <%- include('_form', { action: `/playlists/${playlist.id ?? playlist._id}` ,
            submitText: 'Lưu thay đổi' , submitIcon: 'bi-check-lg' , playlist }) %>

    </div>

</body>

</html>