<form method="POST" action="<%= action %>" class="subscription-form">
    <div class="row g-4">

        <div class="col-lg-8">
            <div class="form-section">

                <div class="section-title">
                    <i class="bi bi-credit-card"></i>
                    Thong tin subscription
                </div>

                <div class="row g-3">

                    <!-- EMAIL -->
                    <div class="col-12">
                        <label class="form-label">
                            Email nguoi dung
                        </label>

                        <input
                            name="email"
                            type="email"
                            value="<%= subscription.user?.email || subscription.email || '' %>"
                            class="form-control form-field"
                            placeholder="nhap@email.com"
                            required
                        >
                    </div>

                    <!-- PLAN -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Plan
                        </label>

                        <select
                            name="plan"
                            class="form-select form-field"
                            required>

                            <option value="">
                                Chon plan
                            </option>

                            <option
                                value="FREE"
                                <%= subscription.plan === 'FREE' ? 'selected' : '' %>>
                                FREE
                            </option>

                            <option
                                value="MONTHLY"
                                <%= subscription.plan === 'MONTHLY' ? 'selected' : '' %>>
                                MONTHLY
                            </option>

                            <option
                                value="YEARLY"
                                <%= subscription.plan === 'YEARLY' ? 'selected' : '' %>>
                                YEARLY
                            </option>
                        </select>
                    </div>

                    <!-- STATUS -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Status
                        </label>

                        <select
                            name="status"
                            class="form-select form-field"
                            required>

                            <option value="">
                                Chon status
                            </option>

                            <option
                                value="ACTIVE"
                                <%= subscription.status === 'ACTIVE' ? 'selected' : '' %>>
                                ACTIVE
                            </option>

                            <option
                                value="EXPIRED"
                                <%= subscription.status === 'EXPIRED' ? 'selected' : '' %>>
                                EXPIRED
                            </option>

                            <option
                                value="CANCELLED"
                                <%= subscription.status === 'CANCELLED' ? 'selected' : '' %>>
                                CANCELLED
                            </option>

                        </select>
                    </div>

                    <!-- START -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Start Date
                        </label>

                        <input
                            name="startDate"
                            type="date"
                            value="<%= subscription.startDate || '' %>"
                            class="form-control form-field"
                            required
                        >
                    </div>

                    <!-- END -->
                    <div class="col-md-6">
                        <label class="form-label">
                            End Date
                        </label>

                        <input
                            name="endDate"
                            type="date"
                            value="<%= subscription.endDate || '' %>"
                            class="form-control form-field"
                            required
                        >
                    </div>

                </div>
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="col-lg-4">
            <div class="form-section side-section">

                <div class="section-title">
                    <i class="bi bi-envelope"></i>
                    Preview
                </div>

                <div class="p-4 rounded-4 bg-light border">

                    <div class="fw-semibold mb-2">
                        Email:
                        <span id="previewEmail">
                            <%= subscription.user?.email || '-' %>
                        </span>
                    </div>

                    <div class="mb-2 text-secondary">
                        Plan:
                        <span id="previewPlan">
                            <%= subscription.plan || '-' %>
                        </span>
                    </div>

                    <div class="text-secondary">
                        Status:
                        <span id="previewStatus">
                            <%= subscription.status || '-' %>
                        </span>
                    </div>

                </div>

                <div class="d-flex gap-3 mt-4">

                    <a
                        href="/subscriptions"
                        class="btn-soft text-decoration-none">
                        <i class="bi bi-arrow-left"></i>
                        Quay lai
                    </a>

                    <button
                        type="submit"
                        class="btn-gradient flex-fill">

                        <i class="bi <%= submitIcon %>"></i>
                        <%= submitText %>

                    </button>
                </div>

            </div>
        </div>

    </div>
</form>

<script>
    const emailInput = document.querySelector('[name="email"]');
    const planInput = document.querySelector('[name="plan"]');
    const statusInput = document.querySelector('[name="status"]');

    const previewEmail = document.getElementById('previewEmail');
    const previewPlan = document.getElementById('previewPlan');
    const previewStatus = document.getElementById('previewStatus');

    emailInput?.addEventListener('input', function () {
        previewEmail.textContent = this.value || '-';
    });

    planInput?.addEventListener('change', function () {
        previewPlan.textContent = this.value || '-';
    });

    statusInput?.addEventListener('change', function () {
        previewStatus.textContent = this.value || '-';
    });
</script>