<form method="POST" action="<%= action %>" class="subscription-form">
    <div class="row g-4">

        <!-- LEFT -->
        <div class="col-lg-8">
            <div class="form-section">

                <div class="section-title">
                    <i class="bi bi-credit-card-2-front"></i>
                    Thông tin Subscription
                </div>

                <div class="row g-3">

                    <!-- EMAIL -->
                    <div class="col-12">
                        <label class="form-label">
                            Email người dùng
                        </label>

                        <input id="emailInput" name="email" type="email"
                            value="<%= subscription.user?.email || subscription.email || '' %>"
                            class="form-control form-field" placeholder="Nhập email người dùng" required>
                    </div>

                    <!-- PLAN -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Gói đăng ký
                        </label>

                        <select id="planInput" name="plan" class="form-select form-field" required>

                            <option value="">
                                Chọn gói
                            </option>

                            <option value="MONTHLY" <%=subscription.plan==='MONTHLY' ? 'selected' : '' %>>
                                MONTHLY
                            </option>

                            <option value="6_MONTHS" <%=subscription.plan==='6_MONTHS' ? 'selected' : '' %>>
                                6_MONTHS
                            </option>

                            <option value="1_YEAR" <%=subscription.plan==='1_YEAR' ? 'selected' : '' %>>
                                1_YEAR
                            </option>

                        </select>
                    </div>

                    <!-- STATUS -->
                    <div class="col-md-6">
                        <label class="form-label">
                            Trạng thái
                        </label>

                        <select id="statusInput" name="status" class="form-select form-field" required>

                            <option value="">
                                Chọn trạng thái
                            </option>

                            <option value="ACTIVE" <%=subscription.status==='ACTIVE' ? 'selected' : '' %>>
                                ACTIVE
                            </option>

                            <option value="EXPIRED" <%=subscription.status==='EXPIRED' ? 'selected' : '' %>>
                                EXPIRED
                            </option>

                            <option value="CANCELLED" <%=subscription.status==='CANCELLED' ? 'selected' : '' %>>
                                CANCELLED
                            </option>

                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT -->
        <div class="col-lg-4">
            <div class="form-section side-section">

                <div class="section-title">
                    <i class="bi bi-person-badge"></i>
                    Preview Subscription
                </div>

                <div class="subscription-preview">

                    <div class="preview-icon">
                        <i class="bi bi-stars"></i>
                    </div>

                    <div class="preview-email" id="previewEmail">
                        <%= subscription.user?.email || '-' %>
                    </div>

                    <div class="preview-plan">
                        <span class="badge bg-primary" id="previewPlan">
                            <%= subscription.plan || 'No Plan' %>
                        </span>
                    </div>

                    <div class="preview-status mt-3">
                        <small class="text-secondary d-block">
                            Status
                        </small>

                        <strong id="previewStatus">
                            <%= subscription.status || '-' %>
                        </strong>
                    </div>

                </div>

                <div class="d-flex flex-column gap-3 mt-4">
                    <button type="submit" class="btn-gradient flex-fill">

                        <i class="bi <%= submitIcon %>"></i>
                        <%= submitText %>
                    </button>
                    <a href="/subscriptions" class="btn-soft text-decoration-none">

                        <i class="bi bi-arrow-left"></i>
                        Quay lại
                    </a>
                </div>

            </div>
        </div>

    </div>
</form>

<script>
    const emailInput = document.getElementById('emailInput');
    const planInput = document.getElementById('planInput');
    const statusInput = document.getElementById('statusInput');

    const previewEmail = document.getElementById('previewEmail');
    const previewPlan = document.getElementById('previewPlan');
    const previewStatus = document.getElementById('previewStatus');
    const previewDuration = document.getElementById('previewDuration');

    emailInput?.addEventListener('input', function () {
        previewEmail.textContent = this.value || '-';
    });

    planInput?.addEventListener('change', function () {
        previewPlan.textContent = this.value || 'No Plan';
    });

    statusInput?.addEventListener('change', function () {
        previewStatus.textContent = this.value || '-';
    });

</script>