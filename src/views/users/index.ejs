<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Quan ly nguoi dung - SoundMind Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        body {
            min-height: 100vh;
            background: radial-gradient(circle at top left, #dbeafe, transparent 35%), radial-gradient(circle at bottom right, #e9d5ff, transparent 35%), #f8fafc;
            font-family: Inter, sans-serif;
            color: #0f172a;
        }

        .sidebar {
            width: 280px;
            min-height: 100vh;
            background: rgba(255, 255, 255, .72);
            backdrop-filter: blur(18px);
            border-right: 1px solid rgba(255, 255, 255, .7);
            padding: 28px;
            position: fixed;
            left: 0;
            top: 0;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 35px;
        }

        .brand-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            background: #eef2ff;
            color: #4f46e5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .brand-title {
            font-weight: 700;
            font-size: 20px;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 18px;
            border-radius: 18px;
            color: #64748b;
            text-decoration: none;
            margin-bottom: 10px;
            transition: .25s;
        }

        .menu-item:hover {
            background: rgba(79, 70, 229, .08);
            color: #4f46e5;
        }

        .menu-item.active {
            background: linear-gradient(to right, #111827, #4f46e5);
            color: white;
            box-shadow: 0 10px 25px rgba(79, 70, 229, .22);
        }

        .content {
            margin-left: 280px;
            padding: 32px;
        }

        .glass-card {
            background: rgba(255, 255, 255, .72);
            backdrop-filter: blur(16px);
            border-radius: 28px;
            border: 1px solid rgba(255, 255, 255, .8);
            box-shadow: 0 15px 35px rgba(15, 23, 42, .06);
        }

        .topbar {
            padding: 22px 28px;
            margin-bottom: 28px;
        }

        .table-card {
            padding: 28px;
            border-radius: 30px;
        }

        .search-box {
            border: none;
            border-radius: 18px;
            padding: 14px 18px;
            background: #f8fafc;
        }

        .search-box:focus {
            background: #f1f5f9;
            box-shadow: none;
            border: none;
            outline: none;
        }

        .table>:not(caption)>*>* {
            background: transparent;
            border-bottom-color: #eef2f7;
            vertical-align: middle;
        }

        .user-avatar {
            width: 52px;
            height: 52px;
            border-radius: 18px;
            object-fit: cover;
            background: #eef2ff;
        }

        .badge-role {
            border-radius: 999px;
            padding: 8px 14px;
            font-size: 12px;
            font-weight: 700;
        }

        .role-admin {
            background: #fee2e2;
            color: #b91c1c;
        }

        .role-user {
            background: #dcfce7;
            color: #15803d;
        }

        .btn-gradient {
            border: none;
            border-radius: 18px;
            padding: 12px 20px;
            color: white;
            font-weight: 600;
            background: linear-gradient(to right, #111827, #4f46e5);
        }

        .action-btn {
            width: 38px;
            height: 38px;
            border-radius: 14px;
            border: none;
            background: #f8fafc;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #0f172a;
            text-decoration: none;
        }

        .delete-form {
            display: inline;
        }

        .pagination-glass {
            gap: 10px;
        }

        .pagination-glass .page-link {
            min-width: 42px;
            height: 42px;
            border: none;
            border-radius: 14px;
            background: rgba(255, 255, 255, .72);
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            padding: 0 16px;
        }

        .pagination-glass .page-item.active .page-link {
            background: linear-gradient(to right, #111827, #4f46e5);
            color: white;
        }

        .pagination-glass .page-item.disabled .page-link {
            opacity: .45;
            pointer-events: none;
        }

        @media(max-width:992px) {
            .sidebar {
                display: none;
            }

            .content {
                margin-left: 0;
            }
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <div class="brand">
            <div class="brand-icon"><i class="bi bi-soundwave"></i></div>
            <div>
                <div class="brand-title">SoundMind</div>
                <small class="text-secondary">Admin Panel</small>
            </div>
        </div>

        <a href="/books" class="menu-item"><i class="bi bi-book"></i> Sách</a>
        <a href="/categories" class="menu-item"><i class="bi bi-tags"></i> Thể loại</a>
        <a href="/authors" class="menu-item"><i class="bi bi-person-lines-fill"></i> Tác giả</a>
        <a href="/users" class="menu-item active"><i class="bi bi-people"></i> Người dùng</a>
        <a href="/chapters" class="menu-item"><i class="bi bi-music-note-list"></i> Chương sách</a>
    </div>

    <div class="content">
        <div class="glass-card topbar d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold mb-1">Quản lý người dùng</h3>
                <div class="text-secondary">Dashboard / Users</div>
            </div>
            <a href="/users/create" class="btn-gradient text-decoration-none"><i class="bi bi-plus-lg"></i> Thêm người
                dùng</a>
        </div>

        <% if (typeof error !=='undefined' && error) { %>
            <div class="alert alert-danger rounded-4 border-0">
                <%= error %>
            </div>
            <% } %>

                <div class="glass-card table-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <form method="GET" action="/users" class="d-flex gap-3 align-items-center">
                            <input type="hidden" name="page" value="0">
                            <input name="size" type="number" min="1" max="100" value="<%= filters.size || 10 %>"
                                class="form-control search-box" style="width:110px" aria-label="Size">
                            <input name="search" value="<%= filters.search || '' %>" class="form-control search-box"
                                placeholder="Tim username, ten, email ...">
                            <button type="submit" class="btn-gradient"><i class="bi bi-search"></i></button>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr class="text-secondary">
                                    <th>Nguoi dung</th>
                                    <th>Email</th>
                                    <th>Dien thoai</th>
                                    <th>Vai tro</th>
                                    <th>Dia chi</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>
                                <% if (users && users.length> 0) { %>
                                    <% users.forEach(user=> { %>
                                        <% const id=user.id ?? user._id ?? user.userId; %>
                                            <% const name=user.name ?? user.username ?? `#${id}`; %>
                                                <% const role=user.role || 'USER' ; %>
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex gap-3 align-items-center">
                                                                <img class="user-avatar"
                                                                    src="<%= user.avatar || `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=eef2ff&color=4f46e5` %>"
                                                                    alt="<%= name %>">
                                                                <div>
                                                                    <div class="fw-semibold">
                                                                        <%= name %>
                                                                    </div>
                                                                    <small class="text-secondary">@<%= user.username ||
                                                                            id %></small>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <%= user.email || '-' %>
                                                        </td>
                                                        <td>
                                                            <%= user.phone || '-' %>
                                                        </td>
                                                        <td><span
                                                                class="badge-role <%= role === 'ADMIN' ? 'role-admin' : 'role-user' %>">
                                                                <%= role %>
                                                            </span></td>
                                                        <td>
                                                            <%= user.address || '-' %>
                                                        </td>
                                                        <td>
                                                            <div class="d-flex gap-2 justify-content-end">
                                                                <a href="/users/<%= id %>/edit" class="action-btn"><i
                                                                        class="bi bi-pencil"></i></a>
                                                                <form method="POST" action="/users/<%= id %>/delete"
                                                                    class="delete-form"
                                                                    onsubmit="return confirm('Xoa nguoi dung nay?')">
                                                                    <button type="submit" class="action-btn"><i
                                                                            class="bi bi-trash"></i></button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <tr>
                                                                <td colspan="6" class="text-center py-5 text-secondary">
                                                                    Khong co du lieu nguoi dung</td>
                                                            </tr>
                                                            <% } %>
                            </tbody>
                        </table>
                    </div>

                    <% const currentPage=pagination.page || 0; const totalPages=pagination.totalPages || 1; %>
                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <div class="text-secondary small">Tong: <strong>
                                    <%= pagination.totalElements %>
                                </strong> nguoi dung</div>
                            <nav>
                                <ul class="pagination pagination-glass mb-0">
                                    <li class="page-item <%= currentPage === 0 ? 'disabled' : '' %>">
                                        <a class="page-link"
                                            href="/users?page=<%= currentPage - 1 %>&size=<%= filters.size %>&search=<%= filters.search || '' %>"><i
                                                class="bi bi-chevron-left"></i></a>
                                    </li>
                                    <% for(let i=0; i < totalPages; i++){ %>
                                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                            <a class="page-link"
                                                href="/users?page=<%= i %>&size=<%= filters.size %>&search=<%= filters.search || '' %>">
                                                <%= i + 1 %>
                                            </a>
                                        </li>
                                        <% } %>
                                            <li
                                                class="page-item <%= currentPage >= totalPages - 1 ? 'disabled' : '' %>">
                                                <a class="page-link"
                                                    href="/users?page=<%= currentPage + 1 %>&size=<%= filters.size %>&search=<%= filters.search || '' %>"><i
                                                        class="bi bi-chevron-right"></i></a>
                                            </li>
                                </ul>
                            </nav>
                        </div>
                </div>
    </div>
</body>

</html>